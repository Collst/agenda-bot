# ── LLM Backend ──────────────────────────────────────────────────────────────
# Switch between "anthropic" and "ollama" without changing any code.
LLM_BACKEND=anthropic

# Anthropic (used when LLM_BACKEND=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google LLM API key and model (used when LLM_BACKEND=gemini)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0

# Ollama (used when LLM_BACKEND=ollama)
# Run `ollama pull qwen2.5:14b` once before first use
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Download credentials.json from Google Cloud Console (see README).
# token.json is auto-generated on first run — do not commit either file.
CLIENT_SECRETS_PATH=credentials.json
TOKEN_PATH=token.json

# —— LangSmith (agent framework) ─────────────────────────────────────────────────
#warning: enabling tracing will cause emails and documents to be sent to a third-party service (LangSmith) for debugging and analysis. 
#Do not enable in production or with sensitive data——consider LangFuse as an alternative for local development.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here

# —— LangFuse (agent observabilityframework; docs recommend generating these with ```openssl rand -base64 32```) ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your_nextauth_secret_here
SALT=your_salt_here

# —— LangFuse Postgres database ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=your_postgres_password_here

# —— N8N (workflow automation) ───────────────────────────────────────────────────────
# change password before sharing
N8N_BASIC_AUTH_PASSWORD=your_n8n_password_here

# ── Google Drive / Docs ───────────────────────────────────────────────────────
# ID of the single Google Doc that contains all meeting notes (tabs by year).
NOTES_DOC_ID=your_notes_doc_id_here

# ID of the single Google Doc that contains all agendas (tabs by year).
AGENDAS_DOC_ID=your_agendas_doc_id_here

# ID of the Drive folder where draft agendas will be saved.
OUTPUT_FOLDER_ID=your_output_folder_id_here

# How many recent meeting note tabs to include (most recent first).
NOTES_TABS_TO_INCLUDE=3

# How many recent agenda tabs to include as format examples.
AGENDA_TABS_TO_INCLUDE=2

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Gmail label applied to committee threads (create this label in Gmail).
GMAIL_LABEL=your_gmail_label_here

# Comma-separated list of committee member email addresses.
# Used as a fallback or supplement to label filtering.
COMMITTEE_EMAILS=member1@example.com,member2@example.com

# How many days back to fetch emails (35 covers a full monthly cycle + buffer).
EMAIL_LOOKBACK_DAYS=35

# ── Agent behaviour ───────────────────────────────────────────────────────────
# Maximum number of review→revise cycles before the agent saves what it has.
MAX_REVISIONS=3
